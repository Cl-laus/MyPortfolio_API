# Fichier chargé automatiquement quand APP_ENV=test.
# Utilisé pour les tests PHPUnit — jamais en production.

APP_ENV=test
APP_SECRET=test_secret_not_used_in_production

# Base SQLite légère — pas besoin de MySQL pour les tests.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Clés JWT générées à la volée pendant les tests (voir ci-cd.yml).
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=testpassphrase

# CORS ouvert en test — pas de restriction de domaine.
CORS_ALLOW_ORIGIN='^.*$'
